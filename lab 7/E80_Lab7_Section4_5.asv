
% read an image
imr = imread("E80IMG2_Lab7.jpg");

% Scaling X and Y axis in meters
Xmin = 107.00004;
Xmax = 170;

Ymin = -90;
Ymax = -25;

pims = imshow(imr);
spatialExtentIm = [pims.XData; pims.YData];

RI = imref2d(size(imr));
RI.XWorldLimits = [0 33];
RI.YWorldLimits = [0 25.789128];

hRef = imshow(imr, RI);

% Plotting the image
figure(1)
clf
% image(imr)
% imshow(imr, 'XData', [Xmin Xmax], 'YData', [Ymin Ymax]);
xlabel('X Measurement [meters]')
ylabel('Y Measurement [meters]')
title('Y Measurement vs. X Measurement')
axis on;

hold on 


